# RYES Environment Variables Template
# Copy this file to .env and fill in your actual credentials

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ryes?retryWrites=true&w=majority

# JWT Authentication Secret Key (Any long random string)
JWT_SECRET=your_jwt_secret_token_secure_key_here

# Admin Login Credentials
ADMIN_EMAIL=admin@ryes.in

# Admin Password Bcrypt Hash (generate with: node hash.js "YourPassword")
# Default password 'admin123' hash:
ADMIN_PASSWORD_HASH='$2a$10$2W.M9Y9DHraAOk6lAtDAWe5T1tw2WTsCGrWw1G2DkcEsiXMlvCn2q'

# Allowed CORS Origins (comma separated)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000

# Server Port
PORT=5000
